# Crée ta clé gratuite sur https://console.groq.com/keys
GROQ_API_KEY=ta_cle_ici
GROQ_MODEL=llama-3.3-70b-versatile
# Modèle du superviseur (routage) : un modèle plus léger suffit, ex. llama-3.1-8b-instant
GROQ_ROUTER_MODEL=llama-3.3-70b-versatile
WHISPER_MODEL=whisper-large-v3-turbo

# Serveur MCP : "stdio" = lancé automatiquement par le backend (local) ; "http" = service séparé (Docker/K8s)
MCP_TRANSPORT=stdio
# MCP_URL=http://127.0.0.1:8765/mcp

# Optionnel
# LOG_LEVEL=INFO
# RAG_TOP_K=4
# MAX_UPLOAD_MB=25
# CORS_ORIGINS=http://localhost:5174
